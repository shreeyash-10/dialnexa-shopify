SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.example.com
SCOPES=read_customers,read_fulfillments,read_inventory,read_orders,read_own_subscription_contracts,read_products
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Keep false until Shopify customer-data access is approved and workflow
# subscriptions have been deployed and tested in production.
ENABLE_AUTOMATION_WORKFLOWS=false

# Required only when ENABLE_AUTOMATION_WORKFLOWS=true.
CRON_SECRET=replace-with-a-long-random-secret
PHONE_HASH_SECRET=replace-with-a-separate-long-random-secret
CALL_PAYLOAD_ENCRYPTION_KEY=replace-with-32-random-bytes-encoded-as-base64
INTEGRATION_API_SECRET=replace-with-a-separate-long-random-secret
SUBSCRIPTION_PAYMENT_UPDATE_URL=https://your-app.example.com/account/payment-method
